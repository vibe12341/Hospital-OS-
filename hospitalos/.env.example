# ==============================================================================
# HospitalOS Environment Configuration (.env.example)
# Copy this file to .env before running the project:
#   cp .env.example .env
# ==============================================================================

# 1. Database Connection
# Supports Firebase Cloud Firestore (in the cloud app) and SQLite/PostgreSQL locally:
FIREBASE_PROJECT_ID="ascendant-alliance-0wpgt"
DATABASE_URL="sqlite:///./hospitalos.db"

# 2. FastAPI / Cloud Backend URL
BACKEND_URL="http://127.0.0.1:8000"

# 3. Gemini Flash & Swappable LLM Provider Settings
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY="YOUR_GEMINI_API_KEY"
LLM_MODEL="gemini-3.8-flash"
